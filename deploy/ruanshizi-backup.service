[Unit]
Description=Consistent Ruanshizi SQLite backup
After=ruanshizi.service

[Service]
Type=oneshot
User=ruanshizi
Group=ruanshizi
WorkingDirectory=/opt/ruanshizi/current
EnvironmentFile=/etc/ruanshizi/app.env
ExecStart=/opt/ruanshizi/node/bin/node deploy/daily-backup.mjs
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/ruanshizi
